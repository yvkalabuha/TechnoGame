+using System.Globalization;
+using System.Collections.Immutable;
+using Singularity.Kernel;
+
+namespace Singularity.Core.Knowledge;
+
+/// <summary>
+/// SANDBOX TASK-0185 (lab/results/sandbox-0185, never in the core build): switches of the slot model (#561, #564, #571) read from the environment.
+/// SLOT=1 on; SLOT_TB months per cost unit; SLOT_GK generation slope of the time (negative = the cost multiplier of the generation);
+/// SLOT_N hist | ceil | fixed:K; SLOT_CMAX "USA:12,..."; SLOT_UPK upkeep share of S per virtual institute; SLOT_DIR 0|1|2; SLOT_BONUS per level (-1 = InstituteParams).
+/// </summary>
+public static class SlotEnv
+{
+    private static string? S(string k) => Environment.GetEnvironmentVariable(k);
+
+    private static double D(string k, double d) => S(k) is { Length: > 0 } v ? double.Parse(v, CultureInfo.InvariantCulture) : d;
+
+    public static readonly bool On = S("SLOT") == "1";
+    public static readonly double TBase = D("SLOT_TB", 9);
+    public static readonly double GenK = D("SLOT_GK", 0.25);
+    public static readonly string Slots = S("SLOT_N") ?? "hist";
+    public static readonly int Dir = (int)D("SLOT_DIR", 0);
+    public static readonly double Bonus = D("SLOT_BONUS", -1);
+    public static readonly double Upk = D("SLOT_UPK", 0.008);
+    public static readonly double SpeedCap = 2.5;
+    public static readonly int NDir = (int)D("SLOT_NDIR", 2);
+    public static readonly string DirF = S("SLOT_DIRF") ?? "sum";   // sum | mean | wmain | max
+    public static readonly int MRule = (int)D("SLOT_MRULE", 0);     // 0: rate = C/T; 1: rate = C·M/T
+    public static readonly bool DiffT = S("SLOT_DIFFT") == "1";     // diffusion/theft discount also shortens the time
+    public static readonly double PK = D("SLOT_PK", 1);             // post-hoc: scale of the money price in the slot model
+    public static readonly string CmaxText = S("SLOT_CMAX") ?? "USA:12,SUN:9,GBR:8,FRA:7,SWE:6";
+
+    public static int Fixed => Slots.StartsWith("fixed:", StringComparison.Ordinal) ? int.Parse(Slots[6..], CultureInfo.InvariantCulture) : -1;
+
+    public static int Cmax(string actor)
+    {
+        foreach (string part in CmaxText.Split(','))
+        {
+            string[] kv = part.Split(':');
+            if (kv.Length == 2 && kv[0] == actor)
+                return int.Parse(kv[1], CultureInfo.InvariantCulture);
+        }
+        return 6;
+    }
