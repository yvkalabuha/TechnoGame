{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/product_class.schema.json",
  "title": "Product classes file (kind: product_class; slice spec §1.4)",
  "type": "object",
  "required": ["kind"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "product_class" },
    "define": { "type": "array", "items": { "$ref": "#/$defs/productClass" } },
    "override": { "type": "array", "items": { "$ref": "#/$defs/productClass" } },
    "patch": { "type": "array", "items": { "$ref": "#/$defs/patch" } },
    "delete": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/localId" } }
  },
  "$defs": {
    "fields": {
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "axis": { "const": "perf" },
        "lighten_order": {
          "description": "Slot tie order for the 'producible' variant (F-PC2).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/localId" }
        },
        "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } },
        "h_pm": { "description": "Hours per person-month (R-HPM).", "type": "number", "exclusiveMinimum": 0 },
        "wage_kh": { "description": "Full labour rate, budget index per 1000 hours (R-WAGE, F-PI1).", "type": "number", "minimum": 0 },
        "maintainability": { "description": "Upkeep divisor.", "type": "number", "exclusiveMinimum": 0 },
        "r_ref": { "description": "Rate of the reference line P0, units per month (spec §3.5 A18).", "type": "number", "exclusiveMinimum": 0 },
        "processes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/process" } },
        "generations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/generation" } }
      }
    },
    "productClass": {
      "$ref": "#/$defs/fields",
      "required": ["id", "axis", "lighten_order", "slots", "h_pm", "wage_kh", "maintainability", "r_ref", "processes", "generations"],
      "unevaluatedProperties": false
    },
    "patch": {
      "$ref": "#/$defs/fields",
      "required": ["id"],
      "unevaluatedProperties": false
    },
    "slot": {
      "type": "object",
      "required": ["id", "base", "alternatives"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "base": { "description": "true: the slot multiplier is the base of perf (engine).", "type": "boolean" },
        "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/alternative" } }
      }
    },
    "process": {
      "description": "Cost inputs of one PRC of the class (R-NP, R-LAB, R-BC).",
      "type": "object",
      "required": ["prc", "n_p", "labour_hours", "base_cost"],
      "additionalProperties": false,
      "properties": {
        "prc": { "$ref": "common.schema.json#/$defs/nodeId" },
        "n_p": { "type": "number", "exclusiveMinimum": 0 },
        "labour_hours": { "type": "number", "exclusiveMinimum": 0 },
        "base_cost": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "generation": {
      "description": "Design inputs of generation gen (R-HF, R-MF, R-AK).",
      "type": "object",
      "required": ["gen", "app", "h_first", "h_floor", "materials_floor", "alloy_kg", "crew_req", "proc_scale", "design_scale"],
      "additionalProperties": false,
      "properties": {
        "gen": { "type": "integer", "minimum": 1 },
        "app": { "$ref": "common.schema.json#/$defs/nodeId" },
        "h_first": { "type": "number", "exclusiveMinimum": 0 },
        "h_floor": { "type": "number", "exclusiveMinimum": 0 },
        "materials_floor": { "type": "number", "minimum": 0 },
        "alloy_kg": { "type": "number", "exclusiveMinimum": 0 },
        "crew_req": { "type": "integer", "minimum": 1 },
        "proc_scale": { "description": "R-PS: multiplier of the process part of unit_cost.", "type": "number", "exclusiveMinimum": 0 },
        "design_scale": { "description": "R-DS: multiplier of design work W.", "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "alternative": {
      "type": "object",
      "required": ["id", "rank", "perf_mult", "prc_set", "requires_nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/localId" },
        "rank": { "type": "integer", "minimum": 1 },
        "perf_mult": { "type": "number", "exclusiveMinimum": 0 },
        "prc_set": { "$ref": "common.schema.json#/$defs/nodeIdList" },
        "requires_nodes": { "$ref": "common.schema.json#/$defs/requirement" }
      }
    }
  }
}
