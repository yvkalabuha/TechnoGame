{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/mod.schema.json",
  "title": "Mod manifest (mod.yaml, ADR-0010)",
  "type": "object",
  "required": ["id", "version", "dependencies", "files"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/modId" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "name": { "type": "string", "minLength": 1 },
    "dependencies": {
      "description": "Required mods. Version range: min inclusive, below exclusive (optional).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "min"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/modId" },
          "min": { "$ref": "common.schema.json#/$defs/semver" },
          "below": { "$ref": "common.schema.json#/$defs/semver" }
        }
      }
    },
    "files": {
      "description": "Data files in load order.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+[.]yaml$" }
    }
  }
}
