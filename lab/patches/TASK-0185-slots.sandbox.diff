+using System.Globalization;
+using Singularity.Core.Data;
+using Singularity.Core.Institutes;
+using Singularity.Kernel;
+
+namespace Singularity.Core.Knowledge;
+
+// SANDBOX TASK-0185: research only through institute slots (#561): one node per slot, progress = scale·mult/T_n, money rate = c_eff/T_n,
+// shortage slows every slot by B/Σrate; directions overlap (#571) under SLOT_DIR. Not for the core build.
+public sealed partial class KnowledgeSystem
+{
+    // accumulator fields per actor (one row per actor, written only by the chunk that owns the actor)
+    private const int AHaz = 14;
+    private int[] _dir3 = [];
+    private const int ASlots = 0, AReal = 1, AFilled = 2, AFront = 3, AScale = 4, AUnspent = 5, AMult = 6, AZeroOv = 7, AGoal = 8, AMonths = 9, AS = 10, AOverlap = 11, AIdleFront = 12, AShort = 13;
+
+    private void InitSlots()
+    {
+        string[] typeDir = ["chem", "chem", "prop", "mech", "metal", "aero"];   // FND, PRN, ENG, CMP, PRC, APP
+        var count = new int[_d];
+        _dir3 = new int[_n];
+        for (int r = 0; r < _n; r++)
+        {
+            double cType = _p.CostByType[(int)_g.Type[r]].ToDouble();
+            int gen = _g.Gen[r];
+            double genF = SlotEnv.GenK >= 0 ? 1 + SlotEnv.GenK * gen : _p.CostGenMultiplier[Math.Min(gen, _p.CostGenMultiplier.Length - 1)].ToDouble();
+            _tn[r] = Fx6.FromDouble(Math.Max(1.0, SlotEnv.TBase * cType * genF));
+            int own = _g.Discipline[r];
+            _dir2[r] = -1;
+            if (own < 0)
+                continue;
+            Array.Clear(count);
+            RequirementLists req = _g.Requires;
+            for (int g = req.GroupStart[r]; g < req.GroupStart[r + 1]; g++)
+            {
+                foreach (int m in req.GroupMembers(g))
+                {
+                    int dm = _g.Discipline[m];
+                    if (dm >= 0 && dm != own)
+                        count[dm]++;
+                }
+            }
+            int best = -1, second = -1;
+            for (int d = 0; d < _d; d++)
+            {
+                if (count[d] > 0 && (best < 0 || count[d] > count[best]))
+                    best = d;
+            }
+            for (int d = 0; d < _d; d++)
+            {
+                if (d != best && count[d] > 0 && (second < 0 || count[d] > count[second]))
+                    second = d;
+            }
+            if (best < 0)
+            {
+                best = _g.DisciplineNames.IndexOf(typeDir[(int)_g.Type[r]]);
+                if (best < 0 || best == own)
+                    best = (own + 1) % _d;
+            }
+            _dir2[r] = best;
+            if (second < 0)
+            {
+                second = _g.DisciplineNames.IndexOf(typeDir[(int)_g.Type[r]]);
+                for (int step = 0; second < 0 || second == own || second == best; step++)
+                    second = (own + 1 + step) % _d;
+            }
+            _dir3[r] = second;
+        }
+    }
+
+    private int Lvl(InstituteSystem inst, int a, int k, int d) => k < 0 || d < 0 ? 0 : inst.Level(new InstituteHandle(a, k), d);
+
+    // Speed value (levels) of institute slot k on node r: D0 = level in the node discipline; else the direction formula over 2 or 3 node directions (missing = 0).
+    private Fx6 DirValue(InstituteSystem inst, int a, int k, int r)
+    {
+        int l1 = Lvl(inst, a, k, _g.Discipline[r]);
+        if (SlotEnv.Dir == 0)
+            return Fx6.FromInt(l1);
+        int l2 = Lvl(inst, a, k, _dir2[r]);
+        int l3 = SlotEnv.NDir >= 3 ? Lvl(inst, a, k, _dir3[r]) : 0;
+        int nd = SlotEnv.NDir >= 3 ? 3 : 2;
+        return SlotEnv.DirF switch
+        {
+            "mean" => Fx6.FromInt(l1 + l2 + l3) / Fx6.FromInt(nd),
+            "wmain" => Fx6.FromRaw(500_000) * Fx6.FromInt(l1) + Fx6.FromRaw(500_000) * Fx6.FromInt(l2 + l3) / Fx6.FromInt(nd - 1),
+            "max" => Fx6.FromInt(Math.Max(l1, Math.Max(l2, l3))),
+            _ => Fx6.FromInt(l1 + l2 + l3),
+        };
+    }
+
+    private void ComputeSlots(int a, long t, List<(int, int, bool)> opened)
+    {
+        InstituteSystem inst = SandboxInstitutes ?? throw new InvalidOperationException("SANDBOX slot model needs institutes on.");
+        int actor = _start.ActorNumber[a];
+        Fx6 s = _inputs.ResearchBudget(a, t);
+        int frontier = 0;
+        foreach (int r in _g.Order)
+        {
+            if (!IsKnown(a, r) && RequiresKnown(a, r))
+            {
+                _trace[a * _n + r] = default(KnowledgeNodeStep) with { InFrontier = true };
+                frontier++;
+            }
+        }
+
+        // slot entries: standing real institutes (slot index), then virtual ones (-1)
+        const int MaxE = 32;
+        Span<int> entry = stackalloc int[MaxE];
+        int ne = 0;
+        InstituteLayout lay = inst.Layout;
+        for (int k = 0; k < lay.SlotCount(a) && ne < MaxE; k++)
+        {
+            if (inst.Standing(new InstituteHandle(a, k)))
+                entry[ne++] = k;
+        }
+        int real = ne;
+        int year = 1945 + (int)((t + _p.CalendarOriginMonths) / 12);
+        int fixedN = SlotEnv.Fixed;
+        int target = fixedN >= 0 ? fixedN
+            : SlotEnv.Slots == "ceil" ? Math.Min(SlotEnv.Cmax(SandboxActorIds[a]), lay.StartingCount(a) + 1 + (year - 1945) / 10)
+            : real;
+        if (target < ne)
+            ne = Math.Max(0, target);
+        int extras = 0;
+        while (ne < target && ne < MaxE)
+        {
+            entry[ne++] = -1;
+            extras++;
+        }
+        Fx6 b = s * (Fx6.One - Fx6.FromDouble(SlotEnv.Upk * extras));
+        if (b < Fx6.Zero)
+            b = Fx6.Zero;
+        Fx6 bonus = SlotEnv.Bonus >= 0 ? Fx6.FromDouble(SlotEnv.Bonus) : _prio!.LevelBonus;
+
+        // nodes: class 0 = AI goals (PATH), class 1 = started nodes (prog desc), class 2 = frontier by weight
+        Span<int> pick = stackalloc int[MaxE];
+        int np = 0, fromGoals = 0;
+        Span<bool> taken = _n <= 512 ? stackalloc bool[_n] : new bool[_n];
+        taken.Clear();
+        Span<int> goalRows = stackalloc int[GoalCap];
+        Span<Fx6> goalMult = stackalloc Fx6[GoalCap];
+        int goals = _inputs.PriorityGoals(a, t, goalRows, goalMult);
+        for (int j = 0; j < goals && np < ne; j++)
+        {
+            int r = goalRows[j];
+            if (!taken[r] && _trace[a * _n + r].InFrontier)
+            {
+                taken[r] = true;
+                pick[np++] = r;
+                fromGoals++;
+            }
+        }
+        while (np < ne)
+        {
+            int best = -1;
+            Fx6 bp = Fx6.Zero;
+            foreach (int r in _g.Order)
+            {
+                if (taken[r] || !_trace[a * _n + r].InFrontier)
+                    continue;
+                Fx6 p = Prog(a, r);
+                if (p > bp)
+                {
+                    best = r;
+                    bp = p;
+                }
+            }
+            if (best < 0)
+                break;
+            taken[best] = true;
+            pick[np++] = best;
+        }
+        while (np < ne)
+        {
+            int best = -1;
+            Fx6 bw = Fx6.FromRaw(-1);
+            foreach (int r in _g.Order)
+            {
+                if (taken[r] || !_trace[a * _n + r].InFrontier)
+                    continue;
+                Fx6 w = _inputs.Priority(a, r, t) * _inputs.J(a, r, t);
+                if (SlotEnv.Dir == 2)
+                {
+                    Fx6 ov = Fx6.Zero;
+                    for (int e = 0; e < ne; e++)
+                    {
+                        Fx6 v = DirValue(inst, a, entry[e], r);
+                        if (v > ov)
+                            ov = v;
+                    }
+                    w = w * (Fx6.One + bonus * ov);
+                }
+                if (w > bw)
+                {
+                    best = r;
+                    bw = w;
+                }
+            }
+            if (best < 0)
+                break;
+            taken[best] = true;
+            pick[np++] = best;
+        }
+
+        // matching node -> entry and multipliers
+        Span<bool> used = stackalloc bool[MaxE];
+        used.Clear();
+        Span<long> mult = stackalloc long[MaxE];
+        Span<long> rate = stackalloc long[MaxE];
+        Fx6 total = Fx6.Zero;
+        double multSum = 0, zeroOv = 0, ovSum = 0;
+        int hazN = 0;
+        for (int i = 0; i < np; i++)
+        {
+            int r = pick[i];
+            int d1 = _g.Discipline[r];
+            int bestE = -1;
+            Fx6 bestScore = Fx6.FromRaw(-1);
+            for (int e = 0; e < ne; e++)
+            {
+                if (used[e])
+                    continue;
+                Fx6 score = SlotEnv.Dir == 2 ? DirValue(inst, a, entry[e], r) : Fx6.FromInt(Lvl(inst, a, entry[e], d1));
+                if (score > bestScore)
+                {
+                    bestE = e;
+                    bestScore = score;
+                }
+            }
+            used[bestE] = true;
+            int k = entry[bestE];
+            Fx6 lvF = DirValue(inst, a, k, r);
+            double lv = lvF.ToDouble();
+            Fx6 m = Fx6.One + bonus * lvF;
+            if (m > Fx6.FromDouble(SlotEnv.SpeedCap))
+                m = Fx6.FromDouble(SlotEnv.SpeedCap);
+            mult[i] = m.Raw;
+            multSum += m.ToDouble();
+            ovSum += lv;
+            zeroOv += lv == 0 ? 1 : 0;
+            Fx6 ceff = CEffOf(a, r, KMix(a, r), t);
+            Fx6 rr = ceff * Fx6.FromDouble(SlotEnv.PK) / TEff(a, r, t);
+            if (SlotEnv.MRule == 1)
+                rr = rr * m;
+            hazN += _g.IsHazard[r] ? 1 : 0;
+            rate[i] = rr.Raw;
+            total += rr;
+        }
+        Fx6 scale = total <= b || total == Fx6.Zero ? Fx6.One : b / total;
+
+        Fx6 spent = Fx6.Zero;
+        for (int i = 0; i < np; i++)
+        {
+            int r = pick[i];
+            Fx6 alloc = Fx6.FromRaw(rate[i]) * scale;
+            if (spent + alloc > s)
+                alloc = s - spent;
+            spent += alloc;
+            int disc = _g.Discipline[r];
+            Fx6 kmix = KMix(a, r);
+            Fx6 ceff = CEffOf(a, r, kmix, t);
+            Fx6 dprog = scale * Fx6.FromRaw(mult[i]) / TEff(a, r, t);
+            Fx6 prog = Prog(a, r) + dprog;
+            bool open;
+            HazardStep hz = default;
+            ulong u = 0;
+            if (_g.IsHazard[r])
+            {
+                if (prog > _p.ProgCap)
+                    prog = _p.ProgCap;
+                hz = KnowledgeMath.Hazard(prog, _p.ThetaStart, _p.HMax, _p.YHalf);
+                if (hz.Active)
+                    u = KnowledgeRng.Hazard(_know, t, actor, _g.Number[r]);
+                open = hz.Active && CounterRng.Chance(u, hz.H);
+            }
+            else
+            {
+                open = prog >= Fx6.One;
+            }
+            _prog[r].Next[a] = prog.Raw;
+            if (disc >= 0)
+                _amount[a * _d + disc] += alloc.Raw;
+            if (open)
+                opened.Add((a, r, true));
+            _trace[a * _n + r] = new KnowledgeNodeStep(true, Fx6.Zero, alloc, kmix, ceff, dprog, prog, hz.Active, hz.H, u, open);
+        }
+        if (spent > s)
+            throw new KnowledgeInvariantException(t, actor, $"R&D spent {spent} exceeds S_a {s} (I4)");
+        _spent[a] = spent.Raw;
+
+        for (int d = 0; d < _d; d++)
+        {
+            Fx6 v = _inputs.DisciplineVolume(a, d, t);
+            _kind[d].Next[a] = KnowledgeMath.KIndStep(KInd(a, d), KD(a, d), v, _p.Eta, _p.VRef, _p.ThetaInd, _p.DeltaInd).Raw;
+        }
+
+        int o = a * AccN;
+        _acc[o + ASlots] += ne;
+        _acc[o + AReal] += real;
+        _acc[o + AFilled] += np;
+        _acc[o + AFront] += frontier;
+        _acc[o + AScale] += scale.ToDouble();
+        _acc[o + AUnspent] += s > Fx6.Zero ? Math.Max(0, (b - spent).ToDouble()) / s.ToDouble() : 0;
+        _acc[o + AMult] += multSum;
+        _acc[o + AZeroOv] += zeroOv;
+        _acc[o + AGoal] += fromGoals;
+        _acc[o + AMonths] += 1;
+        _acc[o + AS] += s.ToDouble();
+        _acc[o + AOverlap] += ovSum;
+        _acc[o + AIdleFront] += frontier > np ? ne - np : 0;   // idle slots while the frontier still had untaken nodes (should be 0)
+        _acc[o + AShort] += scale < Fx6.One ? 1 : 0;
+        _acc[o + AHaz] += hazN;
+    }
+
+    // T_eff: T_n, or with SLOT_DIFFT the same diffusion/theft discount as the price (1 - max(k_diff·known elsewhere, s_steal)).
+    private Fx6 TEff(int a, int r, long t)
+    {
+        if (!SlotEnv.DiffT)
+            return _tn[r];
+        Fx6 diff = KnownElsewhere(a, r) ? _p.KDiff : Fx6.Zero;
+        Fx6 steal = _inputs.StealShare(a, r, t);
+        Fx6 disc = diff > steal ? diff : steal;
+        Fx6 te = _tn[r] * (Fx6.One - disc);
+        return te < Fx6.One ? Fx6.One : te;
+    }
+
+    // Diagnostics only: one row per actor and year into SLOT_TRACE (set per run by the sandbox Lab); not state, not hashed.
+    private void WriteTrace(long month)
+    {
+        if ((month + _p.CalendarOriginMonths) % 12 != 11 || month == _lastWritten)
+            return;
+        _lastWritten = month;
+        string? path = Environment.GetEnvironmentVariable("SLOT_TRACE");
+        if (string.IsNullOrEmpty(path))
+            return;
+        bool header = !File.Exists(path);
+        using var w = new StreamWriter(path, append: true);
+        if (header)
+            w.WriteLine("year,actor,months,slots,real,filled,frontier,idle_front,scale,short_months,unspent,mult,overlap,zero_overlap,goal,s,known,hazard");
+        int year = 1945 + (int)((month + _p.CalendarOriginMonths) / 12);
+        var ci = CultureInfo.InvariantCulture;
+        for (int a = 0; a < _actors; a++)
+        {
+            int o = a * AccN;
+            double mo = Math.Max(1, _acc[o + AMonths]);
+            double fill = Math.Max(1e-9, _acc[o + AFilled]);
+            w.WriteLine(string.Join(",", year.ToString(ci), SandboxActorIds[a], _acc[o + AMonths].ToString(ci),
+                (_acc[o + ASlots] / mo).ToString("F3", ci), (_acc[o + AReal] / mo).ToString("F3", ci), (_acc[o + AFilled] / mo).ToString("F3", ci),
+                (_acc[o + AFront] / mo).ToString("F3", ci), (_acc[o + AIdleFront] / mo).ToString("F3", ci), (_acc[o + AScale] / mo).ToString("F4", ci),
+                _acc[o + AShort].ToString(ci), (_acc[o + AUnspent] / mo).ToString("F4", ci), (_acc[o + AMult] / fill).ToString("F4", ci),
+                (_acc[o + AOverlap] / fill).ToString("F3", ci), (_acc[o + AZeroOv] / fill).ToString("F4", ci), (_acc[o + AGoal] / mo).ToString("F3", ci),
+                (_acc[o + AS] / mo).ToString("F5", ci), KnownCount(a).ToString(ci), (_acc[o + AHaz] / mo).ToString("F3", ci)));
+            Array.Clear(_acc, o, AccN);
+        }
+    }
