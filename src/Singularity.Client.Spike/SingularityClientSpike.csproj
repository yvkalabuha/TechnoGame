<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- Godot 4.7.2 ships a net8.0 host whose runtimeconfig has rollForward=LatestMajor, so it loads this net10.0 assembly
         (and the net10.0 Core/Kernel/Session) on the installed .NET 10 runtime. Needs the .NET 10 runtime next to Godot. -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Singularity.Client.Spike</RootNamespace>
    <AssemblyName>SingularityClientSpike</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Singularity.Session\Singularity.Session.csproj" />
    <ProjectReference Include="..\Singularity.Core\Singularity.Core.csproj" />
    <ProjectReference Include="..\Singularity.Kernel\Singularity.Kernel.csproj" />
  </ItemGroup>
  <!-- geo/arcs.bin is generated, not stored in git (ADR-0011 section 5): ./play.sh builds the client, so it gets the file here, or stops with the fix. -->
  <Target Name="EnsureMapGeo" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../tools/map/ensure_geo.py&quot;" />
  </Target>
</Project>
