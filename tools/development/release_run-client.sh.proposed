#!/usr/bin/env bash
# Start the client. Without arguments: the working tree (same as ./run-globe-spike.sh; flags pass through).
#   ./run-client.sh --release v0.N   start the build of a release from ~/singularity-releases/v0.N (SINGULARITY_RELEASES overrides)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${1:-}" == "--release" ]]; then
  TAG="${2:?usage: ./run-client.sh --release vX.N}"
  DIR="${SINGULARITY_RELEASES:-$HOME/singularity-releases}/$TAG"
  [[ -d "$DIR" ]] || { echo "No build of $TAG in $DIR (python3 tools/development/release.py release $TAG)" >&2; exit 1; }
  shift 2
  if [[ -x "$DIR/bin/singularity" ]]; then exec "$DIR/bin/singularity" "$@"; fi
  exec "$DIR/src/run-globe-spike.sh" "$@"   # no export: run the source snapshot of the tag
fi
exec "$ROOT/run-globe-spike.sh" "$@"
