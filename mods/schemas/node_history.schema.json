{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/node_history.schema.json",
  "title": "Node history file (kind: node_history; TASK-0157, #486). Display data, not in DataHash.",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "node_history"
    },
    "define": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "override": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "delete": {
      "$ref": "common.schema.json#/$defs/nodeIdList"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "epic",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/nodeId"
        },
        "epic": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "url",
              "accessed",
              "check",
              "license",
              "use"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "accessed": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "check": {
                "enum": [
                  "opened",
                  "search-snippet"
                ]
              },
              "license": {
                "enum": [
                  "PD",
                  "CC0",
                  "CC-BY",
                  "other"
                ]
              },
              "use": {
                "enum": [
                  "paraphrase",
                  "quote"
                ]
              }
            }
          }
        },
        "unconfirmed": {
          "type": "boolean"
        }
      }
    }
  }
}
