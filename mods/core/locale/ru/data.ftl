# Knowledge nodes: name, short (<= 12 graphemes), anchor (calibration anchor C4 text).

node-s7-fnd-brayton_cycle =
    .name = Цикл Брайтона
    .short = Брайтон
    .anchor = G0: до старта
    .history = Джордж Брейтон создал в 1872 году поршневой «Ready Motor» с изобарным подводом тепла (поршневой компрессор и поршневой расширитель). Ту же схему с турбиной в качестве расширителя предложил англичанин Джон Барбер в 1791 году. Цикл назван по Брейтону и служит основой расчёта газовых турбин: компрессор, камера сгорания, турбина.

node-s8-fnd-boundary_layer =
    .name = Пограничный слой
    .short = Погр. слой
    .anchor = Прандтль: пограничный слой
    .history = Людвиг Прандтль доложил о пограничном слое на III Международном математическом конгрессе в Гейдельберге в 1904 году; доклад вышел в трудах конгресса в 1905 году (с. 484-491). Оригинал: «Über Flüssigkeitsbewegung bei sehr kleiner Reibung», Verhandlungen des III. Internationalen Mathematiker-Kongresses, Лейпциг, Teubner, 1905, с. 484-491.

node-s8-fnd-compressible_flow =
    .name = Сжимаемое течение
    .short = Сжимаемость
    .anchor = G0: до старта
    .history = Якоб Аккерет опубликовал линеаризованную теорию сверхзвукового профиля (первая работа 1925 года по данным вузовского учебника; NASA указывает 1928 год как начало линейной теории). Прандтль со студентом Теодором Мейером в 1908 году распространил теорию ударных волн на косые скачки. Адольф Буземан в Гёттингенской группе Прандтля описал историю области в обзоре 1971 года «Compressible Flow in the Thirties».

node-s5-fnd-precipitation_hardening =
    .name = Дисперсионное твердение
    .short = Твердение
    .anchor = Вильм: старение Al-Cu (дюралюминий)
    .history = Альфред Вильм открыл старение алюминиевых сплавов в интервале 1903-1911 годов; сплав Al-Cu-Mg-Mn он запатентовал в 1906 году как дуралюмин. Механизм (зоны Гинье-Престона) обнаружили малоугловым рентгеновским рассеянием примерно через 20 лет после открытия.

node-s8-fnd-transonic_aerodynamics =
    .name = Трансзвуковая аэродинамика
    .short = Трансзвук
    .anchor = Bell X-1: M 1.06 14.10.1947
    .history = Рэй Райт из Langley предложил щелевую рабочую часть трубы, Вернон Уорд проверил её на малой трубе; статья Райта и Уорда вышла в 1948 году. По NASA, щелевая секция впервые подтвердила работоспособность на 16-футовой трубе в 1947 году, а в декабре 1950 года труба стала 16-Foot Transonic Tunnel. Ч. Йегер превысил скорость звука на X-1 в октябре 1947 года. Конкурирующая кольцевая труба (1947) была разобрана после успеха щелевой; Collier Trophy 1951 дали Джону Стэку и коллегам за этот инструмент.

node-s5-fnd-high_temperature_creep =
    .name = Высокотемпературная ползучесть
    .short = Ползучесть
    .anchor = Набарро: диффузионная ползучесть
    .history = Nimonic 80 создал Леонард Пфайл на заводе Inco-Mond в Бирмингеме в 1941 году; применён в Power Jets W.2B. Nimonic 80A (около 1945) пошёл в лопатки Rolls-Royce Nene и de Havilland Ghost; затем Nimonic 90 (1945), 100 (1955), 105 (1960), 115 (1964).

node-s7-fnd-turbine_heat_transfer =
    .name = Теплообмен в турбине
    .short = Теплообмен
    .anchor = середина окна G3
    .history = NACA Lewis с 1945 года изучала течение воздуха в полых лопатках; в 1948-1949 разработала ребристые лопатки и методы предсказания характеристик двигателя с охлаждением. В 1950 году опытные охлаждаемые воздухом турбины испытали на двигателях GE I-40; водяное охлаждение (1950-1952) вызвало перепады температуры и поломки лопаток и было оставлено. В 1960-70-е годы основным стало внутреннее конвективное воздушное охлаждение.

node-s5-fnd-solidification_science =
    .name = Наука о затвердевании
    .short = Затвердев.
    .anchor = Раттер–Чалмерс: концентрационное переохлаждение
    .history = Идею концентрационного переохлаждения качественно высказали Раттер и Чалмерс для объяснения ячеистой структуры в олове, а количественную теорию дали Тиллер, Джексон, Раттер и Чалмерс в статье Acta Metallurgica 1:428-437 (1953).

node-s8-prn-gas_turbine =
    .name = Газовая турбина
    .short = Газ. турбина
    .anchor = стендовые ТРД Уиттла и фон Охайна
    .history = He 178 (конструктор фон Охайн) совершил первый турбореактивный полёт 27 августа 1939 года. Gloster E.28/39 с реактивным двигателем Уиттла впервые взлетел 15 мая 1941 года над Крэнвеллом. Фон Охайн разработал двигатель независимо.

node-s8-prn-swept_wing =
    .name = Стреловидное крыло
    .short = Стрел. крыло
    .anchor = Буземан (Volta); Джонс NACA TN 1033 — 1945
    .history = Адольф Буземан предложил стреловидное крыло для снижения волнового сопротивления на конгрессе Вольта в Риме; даты расходятся (NASA указывает 1934 год, другой источник 1935 год). Роберт Джонс (NACA Langley) в 1945 году независимо пришёл к идее стреловидности позади конуса Маха. Комитет Langley во главе с Теодорсеном рекомендовал не публиковать его отчёт; позднее опыты (труба 9 дюймов, свободное падение моделей Гилрута) подтвердили эффект.

node-s8-prn-afterburning =
    .name = Форсаж
    .short = Форсаж
    .anchor = первый форсаж США (NACA AERL для GE I-A)
    .history = Первый американский форсажный контур построила AERL для GE I-A в 1944 году; ранние опыты дали лишь номинальный прирост тяги из-за плохого горения. В 1946 году большой форсаж успешно отработал на GE TG-180 в Altitude Wind Tunnel. Westinghouse испытывала форсаж XJ34-WE-11 на F-80A; в отчёте от 20 января 1949 года описаны первые восемь полётов, работа до 35 000 футов. Первым двигателем с форсажем назван Jumo 004E (Германия).

node-s5-prn-gamma_prime_alloy_design =
    .name = Сплавы с гамма-штрих-фазой
    .short = Гамма-штрих
    .anchor = середина окна G2
    .history = Гамма-штрих фаза Ni3(Al,Ti) упорядочена, когерентна с матрицей и является главным источником высокотемпературной прочности; её прочность малочувствительна к температуре до примерно 600 °C. Лопатки турбин при более 1000 °C содержат значительную долю этой фазы. Nimonic 80 содержит около 1,7 % Al и 20 % Cr, остальное никель.

node-s8-prn-area_rule =
    .name = Правило площадей
    .short = Прав. площ.
    .anchor = Уиткомб: правило площадей
    .history = Ричард Уиткомб (NACA Langley) сформулировал правило площадей в конце 1951 года; конфиденциальный меморандум NACA вышел в сентябре 1952 года по результатам трубных испытаний. Идея: чтобы минимизировать трансзвуковое сопротивление, площадь сечений вдоль самолёта должна меняться как у гладкого тела. Переделка F-102 по этому правилу, по оценке NASA, дала около 25 % прироста скорости; Collier Trophy за 1954 год.

node-s8-prn-multi_spool_compression =
    .name = Многовальное сжатие
    .short = Многовальный
    .anchor = J57: первый запуск двухвального ТРД (01.1950)
    .history = В 1957 году NACA Lewis (RM E57I27) исследовала начало помпажа в двухвальном ТРД в высотной трубе: вращающийся срыв в наружном каскаде на малых оборотах приводит к помпажу на средних и требует перепуска воздуха между компрессорами. Rolls-Royce Olympus стал вторым двухвальным осевым ТРД, первый запуск в мае 1950 года. P&W разделила компрессор на две части на отдельных валах с отдельными турбинами; схема устранила помпаж, а Olympus обошёлся без регулируемых направляющих аппаратов и перепуска.

node-s8-prn-bypass_engine =
    .name = Двухконтурный двигатель
    .short = Двухконтурн.
    .anchor = Conway RCo.2: первый запуск (07.1952)
    .history = Алан Гриффит предлагал двухконтурные схемы ещё в 1930-е годы. Rolls-Royce Conway (RCo.12) назван Смитсоновским музеем первым серийным двухконтурным двигателем: разработку финансировали в 1952 году, первый запуск в 1953 году, госиспытание в 1955 году с рекордно низким удельным расходом топлива на тот момент. Conway ставили на DC-8-40, Boeing 707-420, VC-10 и Victor; степень двухконтурности была малой (около 0,3 по одному источнику).

node-s8-prn-film_cooling =
    .name = Плёночное охлаждение
    .short = Плён. охл.
    .anchor = середина окна G3
    .history = В NACA Lewis обзор плёночного и пористого охлаждения лопаток составили Эккерт и Эсгар (RM E50K15, около 1950 года). Сопоставление отверстий, канавок и щелей (Эккерт, Джексон, Франсиско) показало, что сплошная щель лучше. В 1960-70-е годы основным стало внутреннее конвективное воздушное охлаждение.

node-s8-eng-turbojet_g1 =
    .name = ТРД, поколение 1
    .short = ТРД 1
    .anchor = Meteor в строю (07.1944)
    .history = Фрэнк Уиттл впервые запустил свой реактивный двигатель на стенде 12 апреля 1937 года, а британский Gloster E.28/39 с двигателем Power Jets W.1 взлетел 15 мая 1941 года. В Германии Ханс фон Охайн строил двигатели для Heinkel, и He 178 с его двигателем 27 августа 1939 года стал первым самолётом с турбореактивным двигателем. Серийный Me 262 с двумя осевыми Jumo 004 вступил в строй в 1944 году, но ресурс Jumo 004B был около 25 ч до переборки из-за дефицитных материалов. Конкурировали центробежная схема англичан и осевая немецкая. Для сценария 1945 года это стартовая точка: поколение уже в строю.

node-s8-eng-straight_wing_jet_airframe =
    .name = Планер с прямым крылом
    .short = Прям. крыло
    .anchor = Meteor в строю (07.1944)
    .history = Первые реактивные истребители союзников получили прямое крыло: Gloster Meteor впервые взлетел 5 марта 1943 года и вступил в строй 27 июля 1944 года (616-я эскадрилья), Lockheed XP-80 совершил первый полёт 8 января 1944 года и начал поступать в части в конце 1944 — 1945 годах. Такие машины были проще и дешевле стреловидных, но около скорости звука страдали от роста сопротивления. Это подтолкнуло к стреловидности после 1945 года.

node-s8-eng-turbojet_g2 =
    .name = ТРД, поколение 2
    .short = ТРД 2
    .anchor = Nene: первый запуск 27.10.1944
    .history = Rolls-Royce Nene впервые запустили 27 октября 1944 года; его тяга около 22 кН. Британское правительство разрешило поставки в СССР в сентябре 1946 (10 двигателей) и марте 1947 (ещё 15), после чего Климов без лицензии скопировал его как РД-45, затем ВК-1 с тягой около 26,5 кН для МиГ-15. В США Pratt & Whitney выпускал Nene по лицензии как J42 для Grumman F9F Panther (первый полёт ноябрь 1947). Прогресс этого поколения шёл за счёт улучшения материалов и центробежного компрессора большего размера.

node-s8-eng-swept_wing_airframe =
    .name = Планер со стреловидным крылом
    .short = Планер стр.
    .anchor = F-86: первый полёт 01.10.1947
    .history = Адольф Буземан представил идею стреловидного крыла на конференции Вольта в Риме в 1935 году. В 1945 году Роберт Т. Джонс из NACA независимо получил теорию стреловидности (отчёт от 21 июня 1945). После войны американцы использовали захваченные немецкие данные, и North American F-86 Sabre с углом стреловидности 35° впервые поднялся в воздух 1 октября 1947 года. Messerschmitt P.1101 был готов примерно на 80 % при захвате и дал основу для Bell X-5. Стреловидность вела к проблемам с продольной устойчивостью на малых скоростях, их потом решали на ходу.

node-s8-eng-afterburner =
    .name = Форсажная камера
    .short = Форсаж. кам.
    .anchor = середина окна G2
    .history = Форсаж проверяли ещё в 1941 году на моторно-реактивном Caproni Campini C.C.2 (полёт с дожиганием 11 апреля 1941). В Британии испытательные полёты с дожиганием выполнялись в конце 1944 года на Gloster Meteor I с двигателем Rolls-Royce W2/B23, наземные испытания на Power Jets W2/700 в середине 1945 года. NACA опубликовала теоретическую работу в январе 1947 года. Прирост тяги велик: у J57 около 10 200 фунтов тяги без форсажа и 16 000 с форсажем, примерно +57 % (расчёт по данным справки) ценой резкого роста расхода топлива.

node-s8-eng-all_moving_tail =
    .name = Цельноповоротное оперение
    .short = Цельн. опер.
    .anchor = X-1: цельноповоротный стабилизатор
    .history = У Bell X-1 был горизонтальный стабилизатор с регулируемым углом установки, который рекомендовали Джон Стэк и Роберт Гилрут из NACA: у скорости звука ударная волна лишала руль высоты эффективности. 14 октября 1947 года Чак Йигер, у которого на M 0,94 не хватило хода руля высоты, управлял тангажом перестановкой стабилизатора и преодолел звуковой барьер. Строго «цельноповоротный» стабилизатор (стабилизатор-руль в одном элементе) появился позже: B-47 (1951) назван первым специальным реактивным бомбардировщиком с цельным стабилизатором, на F-86 его добавили после первых серий.

node-s8-eng-turbojet_g3 =
    .name = ТРД, поколение 3
    .short = ТРД 3
    .anchor = J57 (двухвальный 10 000 lbf)
    .history = Pratt & Whitney J57 впервые запустили в 1950 году; это первый в США двигатель класса 10 000 фунтов тяги, с тягой около 11 700 фунтов без форсажа и степенью повышения давления 11,5-12,5. Он ставился на B-52, F-100 и F-102. General Electric J79 (первый запуск 8 июня 1954) получил переменные направляющие лопатки компрессора и степень повышения давления около 13,5, его применяли на F-104 и F-4. Rolls-Royce Avon, первый осевой двигатель компании, запущен 25 марта 1947 года (12 ступеней компрессора).

node-s8-eng-area_ruled_airframe =
    .name = Планер по правилу площадей
    .short = Пл. планер
    .anchor = YF-102A: первый полёт 20.12.1954
    .history = Ричард Уиткомб (NACA Langley) понял правило площадей в 1951 году, меморандум NACA вышел в сентябре 1952 года. Convair YF-102 впервые взлетел 23-24 октября 1953 года и не смог выйти на сверхзвук (около M 0,98); переработанный фюзеляж позволил превысить скорость звука в 1954 году, а серийный F-102A летал с 1955 года. Уиткомб получил Collier Trophy за 1954 год. Независимо правило нашёл Отто Фрэнцль на Junkers в 1943-45 годах, но оно не было применено. Переделка задержала службу самолёта примерно на два года.

node-s8-eng-delta_wing_airframe =
    .name = Планер с треугольным крылом
    .short = Дельта-крыло
    .anchor = YF-102A (дельта)
    .history = Александр Липпиш развивал дельтовидные формы в Германии в 1940-х годах, а после войны работал в США. Первым американским прототипом стал Convair XF-92A (первый полёт 1948). YF-102 имел дельтовидное крыло, а Dassault Mirage III с дельтой впервые взлетел 17 ноября 1956 года; его Mirage IIIA достиг M 2,2 в 1958 году. Достоинства: жёсткость и объём под топливо; недостатки: сопротивление на манёвре и высокая посадочная скорость.

node-s8-eng-variable_geometry_inlet =
    .name = Воздухозаборник с изменяемой геометрией
    .short = Возд. забор.
    .anchor = середина окна G3
    .history = McDonnell XF4H-1 (будущий F-4 Phantom II, первый полёт 27 мая 1958) имел входное устройство с одним неподвижным и одним подвижным клином, рассчитанное на давление между M 1,4 и 2,2. На Mirage III были подвижные полуконусы «souris», смещавшиеся вперёд с ростом числа Маха. На МиГ-21 конус имел три положения, а у МиГ-21ПФ положение конуса менялось непрерывно. У Concorde подвижные панели включаются выше M 1,3 и дают около 63 % тяги на крейсере.

node-s8-eng-air_cooled_turbine_blade =
    .name = Охлаждаемая лопатка турбины
    .short = Возд. охл.
    .anchor = середина окна G4 (Conway — первый с охлаждаемыми лопатками; дата не найдена)
    .history = NASA Glenn описывает охлаждение турбин как приоритет конца 1940-х и 1950-х годов: в Special Projects Laboratory строили охлаждаемые лопатки и системы охлаждения. В начале 1970-х программа ВВС США финансировала лопатку с плёночным и конвективным охлаждением.

node-s8-eng-turbofan_g4 =
    .name = ТРДД, поколение 4
    .short = ТРДД 4
    .anchor = TF30 (форсажный ТРДД): первый полёт
    .history = Rolls-Royce Conway стал первым двухконтурным турбореактивным двигателем в эксплуатации: прототип RCo.2 впервые запущен в июле 1952 года (10 000 фунтов), степень двухконтурности около 0,3. Pratt & Whitney TF30 назван первым серийным двухконтурным двигателем с форсажем, он впервые полетел в 1964 году; TF30-P-1 давал 8 500 фунтов без форсажа и 18 500 с форсажем. Двухконтурность снижала расход топлива за счёт воздуха, обходящего ядро.

node-s8-eng-mach2_airframe_g4 =
    .name = Планер для М2, поколение 4
    .short = Планер М2
    .anchor = F-15: первый полёт 27.07.1972
    .history = Первым самолётом, превысившим M 2, стал Douglas D-558-2 Skyrocket 20 ноября 1953 года с пилотом NACA Скоттом Кроссфилдом (M 2,005). Lockheed XF-104 впервые взлетел 4 марта 1954 года, а серийный F-104A вступил в строй в январе-феврале 1958 года как первый серийный самолёт на M 2. Mirage IIIA достиг M 2,2 24 октября 1958 года, МиГ-21 вошёл в строй в 1959 году. Рост скорости требовал тонких крыльев и новых материалов. Дата игры 1972 не совпадает с реальными датами.

node-s5-cmp-heat_resistant_alloy =
    .name = Жаропрочный сплав
    .short = Жаропр. спл.
    .anchor = Nimonic 80
    .history = Никелевые жаропрочные сплавы серии Nimonic делали в Wiggin (подразделение Inco-Mond); сплав Nimonic 80 появился в 1941 году, и Power Jets W.2B использовал сплав 80. Германия из-за дефицита никеля, кобальта и молибдена применяла для горячих частей Jumo 004 алюминированную мягкую сталь и полые лопатки из сплава Cromadur с 12 % хрома, поэтому ресурс 004B был около 25 ч. Развитие шло от Nimonic 80 (1941) к 80A и 90 (1945), 100 (1955), 105 (1960).

node-s5-cmp-aluminium_alloy_sheet =
    .name = Лист из алюминиевого сплава
    .short = Алюм. лист
    .anchor = дюралюминий: лицензия Dürener Metallwerke
    .history = Альфред Вильм открыл старение алюминиево-медного сплава около 1901 года и к 1906 году довёл состав до практического; немецкий патент DE 244554 от 20 марта 1909 года. Сплав стал называться дюралюминием после покупки патента и выпуска на рынок. К 1930-м он стал основным материалом самолётов.

node-s5-cmp-titanium_alloy =
    .name = Титановый сплав
    .short = Ti-сплав
    .anchor = Ti-6Al-4V
    .history = Вильгельм Кролл начал опыты по получению титана в 1930 году, к 1938-му получил около 50 фунтов металла; затем Горное бюро США развило его процесс. Армия США финансировала сплав Ti-6Al-4V. Douglas X-3 Stiletto (первый полёт 20 октября 1952 года) первым использовал титан в крупных элементах планера. Lockheed A-12 (первый полёт 25 апреля 1962) имел 93 % титана по массе конструкции, а SR-71 около 85 %.

node-s8-cmp-turbine_blade_forged =
    .name = Кованая лопатка турбины
    .short = Кован. лоп.
    .anchor = Nimonic 80 — стандарт роторных лопаток британских ГТД
    .history = В британских двигателях первого поколения лопатки турбины делали из никелевых сплавов Nimonic, жаропрочнее обычной стали. Германия из-за нехватки сырья применяла полые лопатки из сплава Cromadur (12 % хрома) в Jumo 004.

node-s8-cmp-turbine_blade_cast =
    .name = Литая лопатка турбины
    .short = Литая лопат.
    .anchor = середина окна G3
    .history = Литьё по выплавляемым моделям стало основным способом изготовления лопаток газотурбинных двигателей; направленная кристаллизация для столбчатых и монокристаллических структур разработана в 1960-70-х годах.

node-s8-cmp-turbine_blade_cooled =
    .name = Охлаждаемая лопатка (компонент)
    .short = Охл. лопатка
    .anchor = середина окна G4
    .history = Лопатки с внутренними каналами и плёночным охлаждением применялись в двигателях с 1960-70-х: в начале 1970-х программа ВВС США финансировала лопатку с плёночным и конвективным охлаждением. NASA Glenn связывает развитие охлаждения с приоритетами 1940-50-х.

node-s8-cmp-axial_compressor_assembly =
    .name = Осевой компрессор
    .short = Осев. компр.
    .anchor = середина окна G2
    .history = Осевой компрессор применили в Metrovick F.2 (первый запуск ноябрь 1941, 9 ступеней; первый полёт на Lancaster 29 июня 1943), BMW 003 (первый запуск август 1940, 7 ступеней) и Jumo 004 (8 ступеней). Rolls-Royce Avon был первым осевым двигателем компании (запуск 25 марта 1947 года, 12 ступеней). Осевая схема давала больший расход при меньшем диаметре, чем центробежная у Whittle и Nene, но сложнее в производстве.

node-s8-cmp-afterburner_unit =
    .name = Форсажный блок
    .short = Блок форс.
    .anchor = середина окна G2
    .history = Форсажная камера как узел: топливные форсунки, стабилизаторы пламени и регулируемое сопло за турбиной. Первые лётные испытания дожигания в Британии выполнены в конце 1944 года на Gloster Meteor I с двигателем Rolls-Royce W2/B23. У J57 тяга выросла с 10 200 до 16 000 фунтов с форсажем.

node-s5-prc-light_alloy_rolling =
    .name = Прокатка лёгких сплавов
    .short = Прокат лёгк.
    .anchor = дюралюминий в производстве
    .history = Альфред Вильм (Германия) обнаружил, что закалённый сплав Al с 4 % Cu твердеет при комнатной температуре за несколько суток (1903 по одним данным; в другом источнике дата иная). Дюралюмин введён в 1909 г., патенты Вильма купила и вывела материал на рынок фирма Dürener Metallwerke. Листовой дюралюмин применяли в каркасах жёстких дирижаблей; Хуго Юнкерс попробовал его в самолёте J 3 в 1916 г., но работу прекратили до завершения машины.

node-s5-prc-nicr_alloy_melt =
    .name = Выплавка NiCr-сплава
    .short = Плавка NiCr
    .anchor = Nimonic 80 в производстве
    .history = Никель-хромовые сплавы Nimonic разработала британская Mond Nickel (Wiggin, Бирмингем, позднее Inco, теперь торговая марка Special Metals). Nimonic 80 введён около 1941 г., 80A в 1944-45 гг., Nimonic 90 в 1945 г.; по одному источнику Nimonic 75 появился в 1939 г. Сплав с гамма-штрих-фазой от Ti и Al применяли для лопаток турбин, Nimonic 80 использован в Power Jets W.2B. Хромоникелевые стали и аустенитные нержавеющие (1910-15 гг.) были более ранним, менее жаропрочным подходом.

node-s5-prc-superalloy_melt_g2 =
    .name = Выплавка суперсплава
    .short = Суперсплав
    .anchor = середина окна G2
    .history = К 1929 г. нормой стал сплав 80Ni-20Cr с малыми добавками Ti и Al (первые гамма-штрих-выделения), в 1940-х сплавы Nimonic с гамма-штрих-фазой применили для лопаток. Около 1950 г. коммерциализирована вакуумная плавка, в 1950-х появилось вакуумное литьё лопаток. Для горячей секции это шаг от «Nimonic» к поколению литых суперсплавов.

node-s5-prc-vacuum_induction_melt =
    .name = Вакуумная индукционная плавка
    .short = Вак. плавка
    .anchor = промышленная VIM суперсплавов (начало 1950-х)
    .history = Вакуумную индукционную плавку разработали Heraeus Vacuumschmelze и Вильгельм Рон в Ханау около 1917 г., заявка на немецкий патент подана в январе 1918 г. . Сначала её применяли для кобальта и никеля; для суперсплавов вакуумная плавка стала коммерческой около 1950 г. Она убирает водород и азот и позволяет точно выдерживать Al и Ti.

node-s5-prc-titanium_reduction_forging =
    .name = Восстановление и ковка титана
    .short = Ковка Ti
    .anchor = DuPont: первая продажа губчатого титана (09.1948)
    .history = Вильгельм Кролль доложил магниетермический способ восстановления TiCl4 Электрохимическому обществу, его статья «The Production of Ductile Titanium» датирована 1940 г.; позднее в США он занимался цирконием в Albany Research Center. Способ Хантера (натрий) перестал быть коммерческим в 1990-х. Титан в авиации дал выигрыш в массе и жаростойкости.

node-s5-prc-ds_casting =
    .name = Направленная кристаллизация
    .short = Напр. литьё
    .anchor = DS-лопатки: патент P&W 1966; первое применение J58
    .history = Лопатки с направленной кристаллизацией (столбчатые зёрна) повышают стойкость к ползучести и термической усталости. Впервые в серии они появились на двигателях J58 самолёта SR-71; исследования монокристалла начались в 1960-х в Pratt & Whitney и дошли до эксплуатации примерно через десятилетие. Барри Пирси нашёл, что изгиб формы под прямым углом сокращает число столбчатых кристаллов, Тони Джаймеи (P&W) использовал это для монокристалла.

node-s5-prc-alloying_element_refining =
    .name = Очистка легирующих элементов
    .short = Оч. легир.
    .anchor = G0: до старта
    .history = Алюминотермию (Hans Goldschmidt) открыл в 1893 г. и подал патент в 1895 г. (выдан в 1898 г.); с её помощью получают металлический хром из Cr2O3 и очищают некоторые руды. Этот способ давал хром и марганец для сплавов; для суперсплавов нужны ещё Co, Mo, W, Nb, Ti, Al.

node-s5-prc-high_purity_nickel_refining =
    .name = Рафинирование никеля
    .short = Чист. Ni
    .anchor = окно G1
    .history = Карбонильный процесс Людвига Монда (1890) очищает никель: окись углерода образует Ni(CO)4, который разлагается до никеля очень высокой чистоты за один проход. Метод применяла International Nickel Company (бассейн Садбери). Ядовитость карбонила делает его трудным для массового производства.

node-s5-prc-ceramic_shell_moulding =
    .name = Керамические формы
    .short = Керам. форма
    .anchor = середина окна G3
    .history = Литьё по выплавляемым моделям в зубоврачебной практике описал Ф. Филбрук в 1897 г., У. Таггарт (Чикаго) развил метод в 1907 г.; Вторая мировая война усилила спрос на точные детали из труднообрабатываемых сплавов. Кобальтовый сплав Vitallium создал Альберт Меррик для Austenal в 1932 г.; в годы войны сплав Haynes Stellite 21 предложили для турбонагнетателей, показав точное литьё на зубных протезах. Керамическая оболочка наращивается слоями суспензии на восковой модели.

node-s6-prc-precision_gear_bearing =
    .name = Прецизионные шестерни и подшипники
    .short = Шестерни
    .anchor = G0: до старта
    .history = Червячное фрезерование зубьев (хобинг) запатентовал в 1856 году Кристиан Шиле из Ланкастера. В 1897 году Герман Пфаутер построил станок, который резал и прямозубые, и косозубые шестерни, что заметно ускорило производство. Для ответственных передач нарезанные зубья затем доводят шлифованием; точные шестерни и подшипники нужны редукторам и опорам вала турбины.

node-s6-prc-centrifugal_impeller_machining =
    .name = Обработка центробежного колеса
    .short = Крыльчатка
    .anchor = окно G1
    .history = Двигатель Power Jets W.1 Фрэнка Уиттла впервые запущен 14 декабря 1940 г., Gloster E.28/39 впервые поднялся в воздух 15 мая 1941 г. (Крэнуэлл). Компрессор одноступенчатый центробежный с двусторонним рабочим колесом из сплава Hiduminium RR.59. Rolls-Royce Derwent пошёл в серию в 1944 г. и стал двигателем Meteor.

node-s6-prc-precision_blade_forging =
    .name = Точная ковка лопаток
    .short = Ковка лопат.
    .anchor = кованые лопатки из Nimonic 80
    .history = Лопатки турбины Junkers Jumo 004 были полыми: их сгибали и сваривали из листа Cromadur (Krupp, примерно 70 % Fe, 18 % Mn, 12 % Cr) и охлаждали воздухом компрессора. Ресурс ранних двигателей 004B около 10-25 ч, капитальный ремонт каждые 30-50 ч; серия началась только в начале 1944 г., выпущено 5-8 тысяч двигателей. Ансельм Франц возглавил команду в 1939 г. и выбрал осевой компрессор. Британцы шли иным путём: лопатки из Nimonic.

node-s6-prc-axial_compressor_machining =
    .name = Обработка осевого компрессора
    .short = Обр. осев.
    .anchor = середина окна G2
    .history = Pratt & Whitney J57 первый раз запущен в январе 1950 г.; это двухвальный двигатель (два компрессора, две турбины). Степень сжатия военного J57-P-23 равна 11,5:1, гражданского JT3C-7 12,5:1; тяга J57-P-23 растёт с 11 700 до 17 200 фунтов силы с форсажем. Осевой компрессор Jumo 004 (Франц) был в серии с 1944 г.

node-s6-prc-investment_cast_blades =
    .name = Литьё лопаток по выплавляемым моделям
    .short = Литьё лопат.
    .anchor = середина окна G3
    .history = Большинство лопаток турбин отливают по выплавляемым моделям; полые лопатки делают с керамическим стержнем, который растворяют, оставляя охлаждающие каналы. Ранние лопатки были из Nimonic в двигателях Уиттла, вакуумная индукционная плавка в 1950-х подняла температурный предел. Кобальтовый Vitallium (1932) применяли в турбонагнетателях.

node-s6-prc-cooled_blade_drilling =
    .name = Перфорация охлаждаемых лопаток
    .short = Перфорация
    .anchor = середина окна G4
    .history = Б. Р. и Н. И. Лазаренко получили в 1943 г. задание защитить вольфрамовые контакты от эрозии и обнаружили, что в жидком диэлектрике эрозию можно контролировать: так появился электроискровой станок. Сегодня им сверлят ряды отверстий на передней и задней кромках лопаток; газ через отверстия позволяет работать при более высокой температуре.

node-s8-prc-stressed_skin_assembly =
    .name = Сборка работающей обшивки
    .short = Сборка обш.
    .anchor = G0: до старта
    .history = Цельнометаллический Junkers J 1 (1915) имел металлическую обшивку на каркасе (полумонокок, не настоящий монокок). Dornier-Zeppelin Lindau D.I (1918) стал первым цельнометаллическим монококом в серии; алюминиевые монококи распространились только в середине 1930-х. Работа тонкостенных балок в полях растяжения описана в NACA TM-604 (часть I: общие теории).

node-s8-prc-jet_engine_assembly_test =
    .name = Сборка и испытание ТРД
    .short = Сборка ТРД
    .anchor = серийные ТРД для Meteor
    .history = Me 262 с реактивным двигателем впервые поднялся 18 июля 1942 г. (Фриц Вендель, Лайпхайм); опытное подразделение Erprobungskommando 262 образовано 19 апреля 1944 г. Двигатель Jumo 004A достиг межремонтного срока 50 ч к середине 1943 г., 004B требовал проверки турбины после 25 ч, предел колеса 35 ч. Первый боевой вылет Me 262 совершён 25 июля 1944 г. Полёт Me 262 с поршневым двигателем состоялся ещё 18 апреля 1941 г.

node-s8-prc-swept_wing_fabrication =
    .name = Изготовление стреловидного крыла
    .short = Стрел. кр.
    .anchor = F-86 (первый полёт)
    .history = Адольф Буземанн представил принцип независимости применительно к стреловидности на конгрессе Вольта в Риме в 1935 г. Роберт Т. Джонс (NACA) придумал стреловидное крыло в 1944 г., его доклад о тонком крыле датирован маем 1945 г., в открытой печати анализ вышел в 1946 г.; Джонс работал независимо. Прототип XP-86 впервые взлетел 1 октября 1947 г. Изготовление требует точных стыков лонжеронов и обшивки.

node-s8-prc-machined_integral_skins =
    .name = Монолитные обработанные панели
    .short = Монол. панел
    .anchor = середина окна G3
    .history = Рождение числового программного управления обычно связывают с Джоном Парсонсом и Фрэнком Стьюленом (Parsons Corp., Траверс-Сити, Мичиган); первые станки ЧПУ строились в 1940-50-х, на обычных станках с моторами и перфолентой. Они получили Национальную медаль за технологии в 1985 г. Цельнофрезерованные панели стали практичны с ЧПУ.

node-s8-prc-afterburner_fabrication =
    .name = Изготовление форсажной камеры
    .short = Форсаж. изг.
    .anchor = середина окна G2
    .history = Лётные испытания форсажа Rolls-Royce W2/B23 на Gloster Meteor I проведены в конце 1944 г., наземные испытания Power Jets W2/700 в середине 1945 г. Самолёт Caproni Campini C.C.2 летал с работающим форсажем в апреле 1941 г. Американские работы 1948 г. привели к установке на Pirate, Starfire, Scorpion. J57-P-23 с форсажем даёт до 17 200 фунтов силы.

node-s8-app-jet_fighter_g1 =
    .name = Реактивный истребитель, поколение 1
    .short = Истребит. 1
    .anchor = Meteor в строю (07.1944)
    .history = Gloster E.28/39 с двигателем Уиттла впервые взлетел 15 мая 1941 г., прототип Meteor DG206 (Майкл Донт) поднялся 5 марта 1943 г. Первые Meteor пришли в 616-ю эскадрилью в июле 1944 г. (Калмхед, 12 июля), первый боевой вылет против V-1 состоялся 27 июля 1944 г.; скорость F.1 около 671 км/ч. Me 262 впервые летал на реактивной тяге 18 июля 1942 г., подразделение Erprobungskommando с апреля 1944 г., первый бой 25 июля 1944 г.

node-s8-app-jet_fighter_g2 =
    .name = Реактивный истребитель, поколение 2
    .short = Истребит. 2
    .anchor = F-86 (первый полёт 01.10.1947)
    .history = Прототип XP-86 впервые взлетел 1 октября 1947 г. (Джордж Уэлч, Muroc). F-86 введён в ВВС США в 1949 г. (94-я эскадрилья, 1-е авиакрыло), основной истребитель в Корее 1950-53 гг., где встретил стреловидный МиГ-15; первоначальные счета 792:78 позднее пересмотрены. Рекорд скорости F-86A: 671 миль/ч (1080 км/ч) 15 сентября 1948 г.

node-s8-app-jet_fighter_g3 =
    .name = Реактивный истребитель, поколение 3
    .short = Истребит. 3
    .anchor = F-100: первый полёт 25.05.1953
    .history = F-100 Super Sabre поднялся в воздух в 1953 г. (YF-100A, 25 мая 1953 г., Джордж Уэлч) и первым среди серийных самолётов ВВС США достиг сверхзвука в горизонтальном полёте; в строй вошёл 27 сентября 1954 г. (479-е авиакрыло), затем эксплуатация приостановлена после аварий до февраля 1955 г. F-100D взлетел 24 января 1956 г. (скорость 1437 км/ч в музее NASM).

node-s8-app-jet_fighter_g4 =
    .name = Реактивный истребитель, поколение 4
    .short = Истребит. 4
    .anchor = F-15: первый полёт 27.07.1972
    .history = F-15 Eagle впервые летал 27 июля 1972 г., принят на вооружение 9 января 1976 г. (555-я истребительная эскадрилья), два двигателя Pratt & Whitney F100 с форсажем, импульсно-доплеровский радар Hughes APG-63 с обзором вниз. Позднее радары модернизированы до AESA.

node-s8-fnd-electronic_flight_control_theory =
    .name = Теория электронного управления полётом
    .short = Эл. управл.
    .anchor = F-8 DFBW: первый полёт (25.05.1972)
    .history = F-8C DFBW (NASA 802) совершил первый полёт 25 мая 1972 года, пилот Гэри Крайер. Система использовала вычислитель командного модуля «Аполлона» (около 38 тыс. слов памяти, из них 36 тыс. постоянной). Резервом служил аналоговый комплект из трёх вычислителей. По NASA, проект подтвердил принципы электродистанционного управления для военных и гражданских самолётов, а боковая ручка пошла на F-16.

node-s8-fnd-edge_wave_diffraction =
    .name = Теория дифракции на кромках
    .short = Дифр. кромок
    .anchor = Уфимцев: метод краевых волн (1962, оценка)
    .history = Пётр Уфимцев издал «Метод краевых волн в физической теории дифракции» в «Советском радио» (Москва, 1962). Джозеф Келлер дал геометрическую теорию дифракции (JOSA 52:116-130, 1962). Английский перевод книги Уфимцева выпущен Foreign Technology Division ВВС США в 1971 году (FTD-HC-23-259-71). Физическая теория вносит поправку к физической оптике за счёт краевых токов. Применение к расчёту малозаметных форм подтверждено через Echo 1 (узел low_observable_shaping).

node-s5-prn-single_crystal_growth =
    .name = Рост монокристаллов
    .short = Монокристалл
    .anchor = оценка: 1974
    .history = По брошюре ASME, JT9D-7R4 (Boeing 747, DC-10, A300) около 1980 года стал первым коммерческим применением монокристальных деталей турбины. Сплав PWA 1480 описан NASA как коммерческий; его выбирали для лопаток турбонасоса высокого давления главного двигателя Space Shuttle.

node-s5-prn-fibre_composite_laminate_design =
    .name = Проектирование слоистых композитов
    .short = Композиты
    .anchor = F-14: борэпоксидные панели (1970)
    .history = Первой серийной крупной военной деталью из борного волокна стали горизонтальные стабилизаторы F-14 (борная эпоксидка, Avco и Hamilton Standard); это был не углепластик. RAE Фарнборо начал разработку высокомодульного углеволокна на основе ПАН в 1963 году; процесс запатентовало Министерство обороны, лицензия передана через NRDC Rolls-Royce, Morganite и Courtaulds. Ранняя проблема: слабый межслойный сдвиг. Крыло Fairey Delta E10/47 стало первой полётной первичной композитной конструкцией (1947), фюзеляж Spitfire из Aerolite сделан в 1940 году.

node-s8-prn-low_observable_shaping =
    .name = Малозаметные формы
    .short = Малозаметн.
    .anchor = оценка: 1975
    .history = Первый полёт Have Blue (HB1001) состоялся 1 декабря 1977 года, пилот Билл Парк, озеро Грум. F-117A стал боеготовым в октябре 1983 года. Расчёт отражённого сигнала вёл Денис Овершольцер программой Echo 1; в неё вставили теорию кромочной дифракции Уфимцева (перевод 1971). Программа считала только в двух измерениях, поэтому форма получилась гранёной. Echo 1 датирована 1975 годом (Air & Space Forces).

node-s8-eng-fly_by_wire_relaxed_stability =
    .name = Электродистанционное управление, ослабленная устойчивость
    .short = ЭДСУ
    .anchor = YF-16: первый полёт (02.02.1974)
    .history = NASA F-8 Digital Fly-By-Wire выполнил 25 мая 1972 года первый полностью цифровой полёт (лётчик Гэри Кригер) на вычислителе Apollo Guidance Computer, первоначально с аналоговой резервной системой. General Dynamics YF-16 впервые поднялся в воздух 2 февраля 1974 года (случайный подлёт при рулении 20 января); у него четырёхкратно резервированная ЭДСУ и намеренно сниженная статическая устойчивость, F-16 вошёл в строй в 1978 году. Concorde имел аналоговую ЭДСУ, Airbus A320 вошёл в эксплуатацию в 1988 году.

node-s8-eng-turbofan_g5 =
    .name = ТРДД, поколение 5
    .short = ТРДД 5
    .anchor = F100 DEEC: цифровая автоматика (1981-83)
    .history = Pratt & Whitney F100-PW-100 впервые полетел на F-15 27 июля 1972 года, форсажная тяга 23 930 фунтов, отношение тяги к весу 7,88. Модель PW-220 получила цифровой электронный регулятор (DEEC). F100 применяют на F-15 и F-16, по данным компании его налёт превысил 30 млн часов. Дата игры 1981 задана сценарием G56.

node-s8-eng-composite_airframe =
    .name = Композитный планер
    .short = Комп. планер
    .anchor = YAV-8B: первый полёт (09.11.1978)
    .history = McDonnell Douglas AV-8B Harrier II имеет около 26 % композитов по массе планера и экономит около 217 кг (480 фунтов) против металлической конструкции; прототип YAV-8B полетел 9 ноября 1978 года, серийный AV-8B 5 ноября 1981 года. B-2 Spirit (первый полёт 17 июля 1989) в основном состоит из углеграфитового композита.

node-s8-eng-low_observable_airframe =
    .name = Малозаметный планер
    .short = Малозам. пл.
    .anchor = Have Blue: первый полёт (01.12.1977)
    .history = Lockheed Have Blue вышел на лётные испытания в апреле 1977 года, а первый полёт F-117 состоялся в июне 1981 года. Форму рассчитывали по программе Echo 1 Дениса Овершолзера на основе работ Петра Уфимцева 1960-х годов; ВВС США перевели его статью в 1971 году. B-2 впервые полетел 17 июля 1989 года. Малая заметность изменила тактику авиации: машина невидима для радара на нужных дальностях.

node-s8-eng-thrust_vectoring_supercruise_engine =
    .name = Двигатель с вектором тяги и сверхзвуком без форсажа
    .short = Вектор тяги
    .anchor = YF-22: вектор тяги 15.11.1990, сверхзвук без форсажа 03.11.1990
    .history = Rockwell-MBB X-31 впервые полетел 11 октября 1990 года с тремя лопатками-дефлекторами на сопле двигателя GE F404, а на NASA Dryden испытания шли с 1992 года. Pratt & Whitney F119 прошёл наземные испытания EMD-версии с февраля 1993 года и впервые полетел на F-22 7 сентября 1997 года; плоское сопло отклоняется в тангаже на ±20°. F-22 держит сверхзвук без форсажа на M 1,5-1,8. Запрос на ATF выпущен в мае 1983 года.

node-s8-cmp-turbine_blade_single_crystal =
    .name = Монокристаллическая лопатка турбины
    .short = Лопатка МК
    .anchor = оценка: 1982
    .history = Исследования монокристаллических лопаток начались в 1960-х годах в Pratt & Whitney и заняли около десяти лет до внедрения. Метод направленной кристаллизации разработан в 1960-70-х; сплавы первого поколения (PWA 1480) 1980-х, второе и третье поколения содержат около 3 и 6 % рения. Прирост рабочей температуры порядка десятков градусов сопоставим с заменой DS-лопаток.

node-s5-prc-single_crystal_casting =
    .name = Литьё монокристаллов
    .short = Литьё МК
    .anchor = оценка: 1982
    .history = Монокристаллические лопатки (нет границ зёрен) создавались в Pratt & Whitney с 1960-х и дошли до эксплуатации примерно через десятилетие; Барри Пирси предложил изгиб формы для отбора одного зерна, Тони Джаймеи (P&W) положил начало монокристаллу. Первое поколение монокристаллических суперсплавов (PWA 1480, René N4, SRR99) относится к 1980-м.

node-s8-prc-composite_layup_cure =
    .name = Выкладка и отверждение композитов
    .short = Выкладка
    .anchor = оценка: 1978
    .history = Программа NASA ACEE (Aircraft Energy Efficiency) и исследования композитов в Langley шли в 1975-1986 гг. (название отчёта NTRS).

node-s5-prc-low_observable_finishing =
    .name = Малозаметное покрытие
    .short = Покр. малоз.
    .anchor = оценка: 1981
    .history = Lockheed построила два демонстратора Have Blue за свой счёт; первый полёт 1 декабря 1977 г. (Билл Парк), 88 полётов до 1979 г. Первый F-117 поднялся 18 июня 1981 г. (Хэл Фарли), начальная боеготовность в октябре 1983 г., публично признан 10 ноября 1988 г., снят в апреле 2008 г. Около тонны радиопоглощающего материала в листах приклеивали, швы закрывали шпаклёвкой. Концепцию граней обосновала команда Денниса Оверхользера.

node-s8-app-jet_fighter_g5 =
    .name = Реактивный истребитель 4+ (электродистанционное управление)
    .short = Истребит. 4+
    .anchor = Mirage 2000 в строю (1984)
    .history = Современное определение пятого поколения: малозаметность, радар с малой вероятностью перехвата, манёвренная схема, сверхзвуковой крейсерский режим без форсажа, объединение данных датчиков. Машины в строю на декабрь 2025 г.: F-22 (ВВС США, 2005), F-35 (КМП, 2015), J-20 (2017), Су-57 (2020), J-35 (2025). F-117A — ударный самолёт, не истребитель, и обычно в это поколение не включается. Игровой год 1984 соответствует демонстраторам и началу программы ATF, а не вводу в строй. В игре узел подписан «4+ (электродистанционное управление)»: по общепринятому определению (малозаметность, сверхзвуковой крейсер без форсажа) первым пятым поколением в строю стал F-22 (2005); годы узла — ввод в строй у лидера в нашей истории, в игре возможно иначе.

node-s8-app-jet_fighter_g6 =
    .name = Реактивный истребитель, малозаметный, класс F-22
    .short = Класс F-22
    .anchor = F-22: начальная готовность (12.2005)
    .history = Шестое поколение пока не имеет принятого определения: более высокая малозаметность, дальность, оружие за пределами видимости, возможно командование беспилотными ведомыми. NGAD ВВС США начата в 2014 г., Boeing F-47 выбран в марте 2025 г., ввод ожидается в 2030-х; GCAP (Великобритания, Италия, Япония) начат в 2022 г.; по данным Wikipedia общий проект FCAS (NGF) прекращён в 2026 г. Игровой год 2005 не соответствует реальности. В игре узел подписан «малозаметный, класс F-22» (в мире это 5-е поколение). Настоящее 6-е поколение (NGAD, GCAP) в строю не введено: это перспектива, в дереве пока не представлена.

node-s8-eng-aesa_sensor_fusion =
    .name = АФАР и слияние данных датчиков
    .short = АФАР
    .anchor = APG-77: лётные испытания (11.1997, оценка)
    .history = Японский радар J/APG-1 на Mitsubishi F-2 (первый полёт 7 октября 1995, в строю с 2000) считают первым боевым самолётным AESA; американский APG-63(V)2 на 18 F-15C вошёл в строй в 1999 году. F-22 с радаром APG-77 (1956 приёмопередающих модулей) вошёл в строй 15 декабря 2005 года. F-35 развивает слияние данных датчиков (APG-81, EW, DAS), и программное обеспечение слияния задержало программу.

node-s5-cmp-ceramic_matrix_composite =
    .name = Керамоматричный композит (CMC)
    .short = CMC
    .anchor = GE: CMC-кожухи в LEAP (2016, оценка)
    .history = LEAP в 2016 году стал первым широко применяемым изделием с керамическим композитом: CMC-кожух турбины высокого давления работает до около 1300 °C (2400 °F), материал выдерживает на 300-400 °F больше металлов. Введён в эксплуатацию 2 августа 2016 года на A320neo. GE9X (первый полёт 13 марта 2018, сертификат FAA 25 сентября 2020) имеет 65 CMC-деталей, все статические, лопатки первой ступени остаются металлическими.

node-s5-prc-cmc_fabrication =
    .name = Изготовление CMC-деталей
    .short = Изг. CMC
    .anchor = оценка: 2016
    .history = Керамические композиты General Electric (волокна SiC с покрытием, содержащим нитрид бора, в матрице SiC) разрабатываются более 30 лет с 1980-х (Ниска-юна, Нью-Йорк), при поддержке Минэнерго, Минобороны и NASA. Бандажи турбины высокого давления LEAP из CMC сертифицированы FAA и EASA в мае 2016 г.; LEAP стал первым широко применяемым изделием с CMC, рабочая температура до 2400 °F. Для GE9X запланированы пять деталей из CMC (в строю на 777X около 2020 г.).

node-s8-eng-adaptive_cycle_engine =
    .name = Двигатель адаптивного цикла
    .short = Адаптивный
    .anchor = GE XA100: испытания (2021, оценка)
    .history = AFRL объявила программу ADVENT 26 марта 2007 года; за ней последовали AETD (2012) и Adaptive Engine Transition Program (AETP, 2016). GE XA100 начал испытания в декабре 2020 года, второй образец 26 августа 2021 года, а 25 марта 2022 года его впервые запустили в стенде ВВС; заявлены +10 % тяги и +25 % экономичности. Pratt & Whitney XA101 впервые запущен в 2021 году, но в 2023 году ВВС выбрали обновление ядра F135, а не адаптивный двигатель для F-35. Серийных адаптивных двигателей в строю нет.

node-s8-prn-phased_array_radar_pesa =
    .name = Пассивная ФАР
    .short = ПФАР
    .anchor = МиГ-31, РЛС «Заслон»: первый полёт (1975)
    .history = Радиолокатор Заслон (БРЛС-8Б) МиГ-31 называют первой серийной бортовой пассивной ФАР на истребителе; разработка 1975-1980 годов в институте Тихомирова, принят в 1981 году.

node-s5-prn-gaas_wafer_growth =
    .name = Рост арсенида галлия
    .short = Рост GaAs
    .anchor = Mullin и др.: выращивание GaAs методом LEC (1965)
    .history = Метод выращивания кристаллов с жидким герметиком (LEC) впервые продемонстрирован в работе Метца и соавторов (J. Appl. Phys. 33, 1962); первый рост кристаллов GaAs и InAs приписывают Муллину с коллегами.

node-s5-cmp-gaas_mmic =
    .name = Монолитные СВЧ-схемы на GaAs
    .short = GaAs MMIC
    .anchor = Plessey: первая GaAs MMIC (1976)
    .history = Монолитные СВЧ-интегральные схемы первоначально делали на арсениде галлия с полевыми транзисторами MESFET, позднее перешли к HEMT и биполярным гетеротранзисторам. Программа DARPA MIMIC финансировала литейные заводы GaAs для приёмопередающих модулей; её годы указаны в источнике по-разному (1987-1995 и 1988-1999).

node-s8-cmp-solid_state_tr_module =
    .name = Твердотельный приёмопередающий модуль
    .short = ППМ
    .anchor = DARPA MIMIC: аппаратная фаза (1988, оценка)
    .history = Радар APG-77 на F-22 содержит 1956 твердотельных приёмопередающих модулей; ранняя схема использовала равное число отдельных передающих и приёмных модулей.

node-s8-prn-programmable_signal_processing =
    .name = Программируемая обработка сигналов
    .short = Обр. сигнала
    .anchor = APG-63: программируемый процессор (1979, оценка)
    .history = AN/UYS-1 Advanced Signal Processor назван первым программируемым процессором сигналов для высокоскоростной модульной обработки; контракт IBM выигран в 1973 году, ограниченное производство с 1979 года, полное с 1981, около 1700 единиц на флоте. Он служит для обработки данных сонобуёв и входит в системы противолодочных платформ ВМС США, а не радиолокаторов.

node-s8-eng-digital_beamforming =
    .name = Цифровое формирование лучей
    .short = Цифр. лучи
    .anchor = Опытные цифровые решётки (1990, оценка)
    .history = Теорию цифровых антенных решёток начали развивать в 1962 году в СССР (Владимир Варюхин), в 1957 году Мелтон и Бейли работали над аналоговой обработкой сигнала, а с 1960 года для пеленгации применяли быстрые компьютеры.

node-s8-prn-relaxed_static_stability =
    .name = Ослабленная статическая устойчивость
    .short = Неуст. план.
    .anchor = Старт программы CCV (1972, оценка)
    .history = F-4 CCV (PACT) испытывал малую продольную устойчивость и короткий передний горизонтальный рулёж; в отчёте SAE 1974 года вывод: большой выигрыш в манёвренности, предсказания подтверждены в лётных испытаниях. YF-4E с аналоговой электродистанционной системой без механического резерва летал 22 января 1973 года; программа закончилась 23 августа 1974 года. YF-16 использовал малоустойчивую схему с цифровой ЭДСУ.

node-s8-cmp-digital_flight_control_computer =
    .name = Цифровой компьютер управления полётом
    .short = Цифр. ЭВМ
    .anchor = F-8 DFBW, фаза II: три ЭВМ AP-101 (1976, оценка)
    .history = Вычислитель F-8 DFBW работал на Apollo Guidance Computer, с первым полностью цифровым полётом 25 мая 1972 года; самолёт назван первым цифровым ЭДСУ самолётом без механического дублирования. Для боевых самолётов важна четырёхкратная резервированная система F-16 (1978) и Airbus A320, вошедший в эксплуатацию в 1988 году.

node-s8-prn-electronic_engine_control =
    .name = Электронное управление двигателем
    .short = Эл. упр. дв.
    .anchor = Olympus 593 (Concorde): первый полёт (02.03.1969)
    .history = DEEC для F100-PW-100 прошёл лётную оценку на F-15 (одноканальный цифровой регулятор с гидромеханическим резервом, полная власть); испытания шли около полутора лет (статьи 1982 и 1984 годов), проблемы первых двух этапов устранены к четвёртому. Результат привёл к F100 EMD на F-15 и к программе HIDEC (совместное управление двигателем и самолётом).

node-s5-cmp-high_modulus_fibre =
    .name = Высокомодульное волокно
    .short = Волокно
    .anchor = RAE: высокомодульное углеродное волокно (1963)
    .history = В 1963 году У. Уотт, Л. Филлипс и У. Джонсон из Royal Aircraft Establishment в Фарнборо разработали процесс получения углеродного волокна высокой прочности из полиакрилонитрила; параллельно Акио Синдо в Японии в начале 1960-х получил волокно из ПАН. Rolls-Royce применил углепластик в вентиляторе RB211: лопатка разрушилась в испытании на попадание птицы в мае 1970 года, фирма оказалась неплатёжеспособной к январю 1971 года и была национализирована после введения внешнего управления 4 февраля 1971 года.

node-s8-prn-thrust_vectoring_nozzle =
    .name = Сопло с вектором тяги
    .short = Сопло ВТ
    .anchor = F-15 S/MTD: полёт с вектором тяги (16.05.1989)
    .history = F-15 S/MTD получил сопла с отклонением тяги по тангажу и передние горизонтальные плоскости в 1988 году; USAF оценивала их в 1989-1991 годах; первый этап испытаний по короткому взлёту завершён 31 января 1989 года. По Flight International, производная от сопла P&W с этого самолёта устанавливается на F119 для F-22. X-31 впервые полетел 11 октября 1990 года как исследовательская машина управления вектором тяги.

node-s8-prn-rcs_computational_prediction =
    .name = Расчёт радиолокационной заметности
    .short = Расчёт ЭПР
    .anchor = Lockheed: программа Echo 1 (1975)
    .history = Echo 1 (1975) позволяла прогнозировать отражение формы; в том же году DARPA приняла инициативное предложение Lockheed. Программа Echo 1 (Lockheed, автор Денис Овершольцер) оценивала ЭПР проектов; ранние тесты показали ошибки в расчёте кромочной дифракции, и в программу ввели результаты Уфимцева. Расчёт был двумерным и позволял гранёные формы, но не гладкие.

node-s8-eng-integrated_avionics_architecture =
    .name = Интегрированная архитектура авионики
    .short = Авионика
    .anchor = Pave Pillar (1986, оценка)
    .history = Авионику F-22 строили по архитектуре DoD «Pave Pillar» с технологиями программы VHSIC; два вычислителя Hughes CIP обрабатывают данные датчиков, по 10,5 млрд операций в секунду каждый. Стандарт шины MIL-STD-1553B выпущен в 1978 году как единый для трёх видов вооружённых сил. Концепция интегрированной модульной авионики, как считается, возникла в авионике истребителей четвёртого поколения.

node-s5-cmp-silicon_carbide_fibre =
    .name = Волокно карбида кремния
    .short = Вол. SiC
    .anchor = Yajima: SiC-волокно из поликарбосилана (1975)
    .history = Профессор Сэйси Яджима в Японии в 1975 году получил волокно карбида кремния из полимера поликарбосилана (процесс Яджимы); патент США 4 052 430 выдан 4 октября 1977 года. Nippon Carbon развила его в серийное волокно Nicalon. Волокно стало основой композитов SiC/SiC для горячих частей двигателей.

node-s5-prn-matrix_infiltration_cvi =
    .name = Химическое газофазное уплотнение матрицы
    .short = CVI
    .anchor = Naslain: первый CMC методом CVI (1977)
    .history = Oak Ridge National Laboratory развил принудительное химическое осаждение из газа (FCVI) с градиентами температуры и давления для толстостенных керамических деталей; в 1994 году получены диски диаметром 24,6 см и толщиной 1,27 см. Доклад Д. Стинтона в 1987 году описывал карбидокремниевые композиты с непрерывными волокнами, полученные CVI, и модели инфильтрации.

node-s5-prn-environmental_barrier_coating =
    .name = Барьерное покрытие от среды
    .short = Покрытие
    .anchor = NASA/GE/P&W: покрытие первого поколения (2000, оценка)
    .history = NASA Glenn описывает эволюцию систем EBC для SiC/SiC через несколько поколений (Чжу, 2016); отдельная презентация 2017 года (Ли и др., Santa Fe) посвящена текущим испытаниям. Первое поколение EPM Gen I (BSAS/муллит+BSAS/Si, 1995-2000), второе UEET Gen II (RE2Si2O7 или RE2SiO5, 2000-2004); следующее направление на 2020-2025 годы с CMC 2400 °F и EBC 2700 °F. Испытания шли на горелочной установке высокого давления NASA.

node-s8-prn-variable_cycle_engine =
    .name = Двигатель переменного цикла
    .short = Перем. цикл
    .anchor = YF120 на YF-22: первый полёт (29.09.1990)
    .history = ВВС США выбрали P&W F119 вместо GE YF120 для ATF в августе 1991 года; по статье Defense ARJ, YF120 превосходил YF119 на высоких числах Маха, но считался более рискованным, а P&W набрала больше часов испытаний. YF120 менял степень двухконтурности для разных режимов полёта.

node-s8-prn-adaptive_third_stream_fan =
    .name = Вентилятор третьего контура
    .short = 3-й контур
    .anchor = GE ADVENT: двигатель (26.11.2013)
    .history = GE и ВВС США работают над адаптивным двигателем с 2007 года: сначала ADVENT, затем AETD. Второй двигатель XA100 запущен 26 августа 2021 года в Эвендейле, последний прототип по AETP; первый двигатель испытывался с декабря 2020 года. Третий поток GE описывает как средство теплового управления; в ноябре 2023 года сообщили о третьем цикле испытаний.

