<Project Sdk="Microsoft.NET.Sdk">
  <!-- Simulation Lab host (ADR-0008, TASK-0005): manifest, single run, process-per-run matrix. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Singularity.Lab</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singularity.Kernel\Singularity.Kernel.csproj" />
    <!-- Model interface (Singularity.Core.Simulation) and models; Core never references Lab. -->
    <ProjectReference Include="..\Singularity.Core\Singularity.Core.csproj" />
    <!-- Session models (JetSlice, JetSliceCalib; TASK-0044): the slice world is reached only through SliceSession and its read views (ADR-0014). -->
    <ProjectReference Include="..\Singularity.Session\Singularity.Session.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="examples\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- lab bench R3 (ADR-0017): XxHash3/XxHash128 reference timing only. Lab only: Kernel and Core never get this package (MIT). -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>
</Project>
